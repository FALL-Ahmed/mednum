# ──────────────────────────────────────────────────────────────────────────────
# Axone — variables d'environnement (.env)
# Copie ce fichier en .env et remplis tes valeurs.
# IMPORTANT : ne jamais committer le fichier .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase Axone (projet SÉPARÉ de ProfNum) ────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Prisma — connexion directe à la base Supabase (pour les migrations) ───────
# Supabase → Settings → Database → Connection string → "URI" (port 5432)
DIRECT_URL=postgresql://postgres:[MOT_DE_PASSE]@db.VOTRE_PROJECT_ID.supabase.co:5432/postgres

# Supabase → Settings → Database → Connection string → "Session" pooler (port 6543)
DATABASE_URL=postgresql://postgres.[VOTRE_PROJECT_ID]:[MOT_DE_PASSE]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Anthropic (stocké comme secret Supabase côté serveur) ────────────────────
# Ne jamais mettre ici côté client.
# Commande : supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# ── Fallbacks IA client-side (optionnels) ────────────────────────────────────
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=
