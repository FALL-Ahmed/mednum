{
  "expo": {
    "name": "Axone",
    "slug": "axone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B1E34"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.axone.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1E34"
      },
      "package": "com.axone.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-document-picker",
      "expo-audio",
      "expo-font",
      "expo-web-browser"
    ],
    "scheme": "axone"
  }
}
