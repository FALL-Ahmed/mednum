// Schéma MedNum — base séparée de ProfNum
// Prisma est utilisé uniquement pour les migrations SQL.
// L'app mobile utilise @supabase/supabase-js directement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Supabase pooler (port 6543)
  directUrl = env("DIRECT_URL")         // Supabase direct (port 5432) — pour les migrations
}

// ─── Promotions médicales ─────────────────────────────────────────────────────
// Remplace les "classes" de ProfNum par les promotions UNAM (P1 à P5+)

model Promotion {
  id          String   @id @default(uuid())
  name        String                         // "P1", "P2", "P3", "P4", "P5", "Résidanat"
  description String?                        // "1ère année de médecine", "Résidanat — Post-graduée"
  year        Int?                           // Année académique (ex: 2025)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  students Student[]
  courses  Course[]

  @@map("promotions")
}

// ─── Étudiants en médecine ────────────────────────────────────────────────────

model Student {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")   // Supabase Auth UID
  name          String
  promotionId   String?  @map("promotion_id")
  promotionName String?  @map("promotion_name")     // copie dénormalisée pour affichage rapide
  schoolName    String?  @map("school_name")         // ex: "FMPOS UNAM"
  parentPhone   String?  @map("parent_phone")        // WhatsApp parent
  createdAt     DateTime @default(now()) @map("created_at")

  promotion Promotion? @relation(fields: [promotionId], references: [id])

  @@map("students")
}

// ─── Cours PDF médicaux ───────────────────────────────────────────────────────

model Course {
  id          String   @id @default(uuid())
  name        String                             // "Anatomie — Membre Supérieur"
  subjectName String   @map("subject_name")      // "Anatomie"
  fileName    String   @map("file_name")
  fileUrl     String?  @map("file_url")          // URL Supabase Storage
  pages       Int      @default(0)
  content     String?  @db.Text
  language    String?  @default("fr")
  promotionId String?  @map("promotion_id")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  promotion Promotion?    @relation(fields: [promotionId], references: [id])
  chunks    CourseChunk[]

  @@map("courses")
}

model CourseChunk {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  title    String
  content  String @db.Text
  index    Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_chunks")
}

// ─── Quota journalier ─────────────────────────────────────────────────────────

model QuotaUsage {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  dailyUsed  Int      @default(0) @map("daily_used")
  dailyLimit Int      @default(20) @map("daily_limit")
  plan       String   @default("trial")  // "trial" | "freemium" | "one_subject" | "three_subjects" | "full" | "admin"
  trialEndsAt DateTime? @map("trial_ends_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("quota_usage")
}

// ─── Plans d'abonnement ───────────────────────────────────────────────────────

model Plan {
  id           String  @id @default(uuid())
  plan         String  @unique              // identifiant interne
  label        String                       // nom affiché
  priceMonthly Float   @map("price_monthly")
  priceYearly  Float?  @map("price_yearly")
  sortOrder    Int     @default(0) @map("sort_order")

  @@map("plans")
}

// ─── Demandes d'abonnement ────────────────────────────────────────────────────

model Subscription {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  plan        String
  status      String    @default("pending")   // "pending" | "active" | "rejected"
  receiptUrl  String?   @map("receipt_url")
  method      String?                          // "bankily" | "masrivi" | "sedad" | "click"
  duration    String?                          // "monthly" | "yearly"
  activatedAt DateTime? @map("activated_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("subscriptions")
}
